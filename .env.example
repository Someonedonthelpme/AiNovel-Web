# Copy to .env and adjust. .env is gitignored and must never be committed.

# Postgres. The dedicated container for this project listens on 5433, so it does
# not collide with any other Postgres you have running on 5432.
DATABASE_URL=postgresql://ainovel:ainovel_dev_local@localhost:5433/ainovel

# LM Studio, OpenAI-compatible endpoint.
LOCAL_LLM_URL=http://localhost:1234/v1

# Multilingual embedder. Thai collapses entirely on nomic-embed, so this must
# stay a multilingual model or the canon guard silently stops working.
LOCAL_EMBED_MODEL=text-embedding-bge-m3
